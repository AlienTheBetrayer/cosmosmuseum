// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Users {
  id           String             @id(map: "users_pkey")
  email        String             @unique(map: "users_email_key")
  username     String             @unique(map: "users_username_key")
  passwordHash String?            @map("password_hash")
  color        String
  avatarUrl    String             @map("avatar_url")
  status       String?
  lastSeenAt   TimestamptzString? @map("last_seen_at")
  editedAt     TimestamptzString? @map("edited_at")
  createdAt    TimestamptzString  @default(now()) @map("created_at")
  authSessions AuthSessions[]
  codes        Codes[]
  emojis       Emojis[]

  @@rls
  @@map("users")
}

model AuthSessions {
  id               String             @id(map: "auth_sessions_pkey")
  refreshTokenHash String             @map("refresh_token_hash")
  userId           String             @map("user_id")
  editedAt         TimestamptzString? @map("edited_at")
  createdAt        TimestamptzString  @default(now()) @map("created_at")
  expiryAt         TimestamptzString  @map("expiry_at")
  user             Users              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey", index: false)

  @@rls
  @@map("auth_sessions")
}

model Codes {
  id        String             @id(map: "codes_pkey")
  userId    String             @map("user_id")
  code      String?
  expiryAt  TimestamptzString  @map("expiry_at")
  createdAt TimestamptzString? @default(now()) @map("created_at")
  user      Users              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "codes_user_id_fkey", index: false)

  @@rls
  @@map("codes")
}

model Emojis {
  id        String             @id(map: "emojis_pkey")
  emoji     String
  exhibitId String             @map("exhibit_id")
  userId    String?            @map("user_id")
  editedAt  TimestamptzString? @map("edited_at")
  createdAt TimestamptzString  @default(now()) @map("created_at")
  user      Users?             @relation(fields: [userId], references: [id], onDelete: SetNull, map: "emojis_user_id_fkey", index: false)

  @@rls
  @@map("emojis")
}
